:root {
  color-scheme: light;
  --page: #f5f6f7;
  --surface: #fff;
  --soft: #f8f9fa;
  --border: #dfe3e6;
  --strong: #c9cfd4;
  --text: #1d2429;
  --muted: #667078;
  --accent: #1868db;
  --accent-hover: #1258bd;
  --success: #18794e;
  --success-bg: #eef8f2;
  --warning-bg: #fff8e8;
  --danger: #b42318;
  --danger-bg: #fff3f2;
  --shadow: 0 1px 2px rgba(18, 28, 36, 0.05);
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  background: var(--page);
  color: var(--text);
  font:
    14px/1.5 -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}
header,
main {
  width: min(1180px, calc(100% - 40px));
  margin-inline: auto;
}
header {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  border-bottom: 1px solid var(--border);
}
.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}
.brand-mark {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: #1f2933;
  color: #fff;
  font-size: 12px;
  font-weight: 750;
  letter-spacing: 0.04em;
}
h1,
h2,
h3,
p {
  margin: 0;
}
h1 {
  font-size: 17px;
  line-height: 1.3;
  font-weight: 680;
  letter-spacing: -0.01em;
}
h2 {
  font-size: 17px;
  line-height: 1.35;
  font-weight: 680;
  letter-spacing: -0.01em;
}
h3 {
  font-size: 15px;
  font-weight: 680;
}
header p,
.card p {
  color: var(--muted);
}
.status,
.pill {
  padding: 5px 9px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--surface);
  color: var(--muted);
  font-size: 12px;
  white-space: nowrap;
}
main {
  padding: 24px 0 56px;
}
.card {
  margin-bottom: 14px;
  padding: 20px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--surface);
  box-shadow: var(--shadow);
}
.section-head,
.search-card,
.subhead,
.issue,
.addbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}
.section-label {
  margin-bottom: 3px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
}
.search-card form {
  display: flex;
  gap: 8px;
  width: min(560px, 100%);
}
input,
textarea,
select,
button {
  font: inherit;
}
input,
textarea,
select {
  width: 100%;
  min-height: 40px;
  padding: 9px 11px;
  border: 1px solid var(--strong);
  border-radius: 7px;
  outline: none;
  background: #fff;
  color: var(--text);
}
input:focus,
textarea:focus,
select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(24, 104, 219, 0.12);
}
textarea {
  min-height: 110px;
  resize: vertical;
}
button {
  min-height: 38px;
  padding: 8px 14px;
  border: 1px solid var(--accent);
  border-radius: 7px;
  background: var(--accent);
  color: #fff;
  font-weight: 620;
  cursor: pointer;
}
button:hover {
  background: var(--accent-hover);
  border-color: var(--accent-hover);
}
button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
.secondary {
  border-color: var(--strong);
  background: #fff;
  color: var(--text);
}
.secondary:hover {
  background: var(--soft);
  border-color: #adb5bc;
}
.secondary.danger {
  color: var(--danger);
}
.settings {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: end;
  gap: 12px;
  margin-top: 18px;
  padding-top: 18px;
  border-top: 1px solid var(--border);
}
.settings p {
  grid-column: 1/-1;
}
.hidden {
  display: none !important;
}
.muted {
  color: var(--muted);
}
.issues {
  margin-top: 14px;
  border-top: 1px solid var(--border);
}
.issue {
  padding: 14px 0;
  border-bottom: 1px solid var(--border);
}
.issue:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}
.issue small {
  color: var(--muted);
}
a {
  color: var(--accent);
  text-decoration: none;
}
a:hover {
  text-decoration: underline;
}
code {
  padding: 2px 5px;
  border-radius: 4px;
  background: #edf0f2;
}
.warnings {
  margin-top: 14px;
  padding: 11px 13px;
  border-left: 3px solid #d69e2e;
  border-radius: 5px;
  background: var(--warning-bg);
  color: #684600;
}
.warnings > div + div {
  margin-top: 5px;
}
.fields {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 13px;
  margin-top: 18px;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.field span {
  color: #4e5961;
  font-size: 12px;
  font-weight: 600;
}
.field.wide {
  grid-column: span 2;
}
.field.full {
  grid-column: 1/-1;
}
.coordinate-review {
  margin-top: 20px;
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--soft);
}
.coordinate-grid {
  display: grid;
  grid-template-columns: minmax(320px, 1.35fr) 1fr;
  gap: 14px;
  margin-top: 14px;
}
.coordinate-grid iframe {
  width: 100%;
  min-height: 300px;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: #e9ecef;
}
.evidence {
  display: grid;
  align-content: start;
  gap: 8px;
}
.evidence-item {
  padding: 9px 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: #fff;
}
.evidence-item.agrees {
  border-color: #83c5a3;
  background: var(--success-bg);
}
.evidence-item small {
  color: var(--muted);
}
.confirm-coordinate {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-top: 13px;
  color: #3d474e;
}
.confirm-coordinate input {
  width: auto;
  min-height: auto;
  margin-top: 3px;
}
.subhead {
  margin: 26px 0 12px;
}
.photos {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
  gap: 12px;
}
.photo {
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #fff;
}
.photo.selected {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(24, 104, 219, 0.12);
}
.photo img {
  display: block;
  width: 100%;
  height: 145px;
  object-fit: cover;
  background: #edf0f2;
}
.photo-body {
  padding: 10px;
}
.photo-title,
.photo-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.photo-title {
  font-size: 12px;
  font-weight: 600;
}
.photo-meta {
  color: var(--muted);
  font-size: 11px;
}
.photo-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 9px;
}
.image-roles { display: grid; gap: 5px; margin-top: 9px; padding-top: 8px; border-top: 1px solid var(--border); font-size: 12px; }
.image-roles input, .remove-photo input { width: auto; min-height: auto; }
.site-picker, .publish-actions { display: grid; grid-template-columns: 1fr 1.2fr auto; gap: 8px; margin-top: 14px; }
#siteEditor { margin-top: 20px; padding-top: 4px; border-top: 1px solid var(--border); }
.move-buttons { display: flex; gap: 5px; margin-top: 8px; }
.move-buttons button { min-height: 30px; padding: 3px 10px; }
.remove-photo { display: block; margin-top: 9px; color: var(--danger); font-size: 12px; }
.publish-card { display: grid; grid-template-columns: 1fr minmax(440px, 1.4fr); gap: 24px; align-items: center; }
.photo-actions input {
  width: auto;
  min-height: auto;
}
.photo-actions label {
  cursor: pointer;
}
.cover {
  color: var(--muted);
  font-size: 11px;
}
details {
  margin-top: 20px;
  padding-top: 14px;
  border-top: 1px solid var(--border);
}
summary {
  cursor: pointer;
  font-weight: 600;
}
.sources {
  display: grid;
  gap: 7px;
  margin-top: 12px;
}
.addbar {
  position: sticky;
  bottom: 10px;
  margin-top: 22px;
  padding: 12px 14px;
  border: 1px solid var(--strong);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 4px 18px rgba(18, 28, 36, 0.1);
  backdrop-filter: blur(10px);
}
.addbar p {
  color: var(--muted);
}
.toast {
  position: fixed;
  right: 20px;
  bottom: 20px;
  z-index: 20;
  max-width: 440px;
  padding: 12px 14px;
  border: 1px solid #83c5a3;
  border-radius: 7px;
  background: var(--success-bg);
  color: #125c3b;
  box-shadow: 0 8px 28px rgba(18, 28, 36, 0.16);
}
.toast.error {
  border-color: #f0aaa4;
  background: var(--danger-bg);
  color: var(--danger);
}
@media (max-width: 760px) {
  header,
  main {
    width: min(100% - 24px, 1180px);
  }
  header {
    min-height: 68px;
  }
  .brand-mark {
    display: none;
  }
  .search-card,
  .section-head,
  .subhead,
  .issue,
  .addbar {
    align-items: stretch;
    flex-direction: column;
  }
  .search-card form {
    width: 100%;
  }
  .settings {
    grid-template-columns: 1fr;
  }
  .settings p {
    grid-column: auto;
  }
  .fields {
    grid-template-columns: 1fr 1fr;
  }
  .field.wide {
    grid-column: span 2;
  }
  .coordinate-grid {
    grid-template-columns: 1fr;
  }
  .photos {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .addbar {
    bottom: 6px;
  }
  .addbar button {
    width: 100%;
  }
  .site-picker, .publish-actions, .publish-card { grid-template-columns: 1fr; }
}
@media (max-width: 460px) {
  .status {
    display: none;
  }
  .search-card form {
    flex-direction: column;
  }
  .fields {
    grid-template-columns: 1fr;
  }
  .field.wide {
    grid-column: span 1;
  }
  .photos {
    grid-template-columns: 1fr;
  }
}


/* Atlas admin clarity refresh */
:root {
  --blue-soft: #eef5ff;
  --blue-line: #a9c9f5;
  --green-soft: #eef9f2;
  --green-line: #9ed1b0;
  --amber-soft: #fff8e7;
  --amber-line: #e4c46b;
  --slate-soft: #f3f5f7;
}

body {
  background: #edf1f5;
}

header {
  border-bottom: 0;
}

main {
  display: grid;
  gap: 18px;
}

.card {
  margin-bottom: 0;
  padding: 24px;
  border-color: #d5dce3;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(29, 36, 41, 0.06);
}

.card h2 {
  color: #18222b;
}

.card h3 {
  color: #26343e;
}

/* Search configuration */
main > .card:first-child {
  border-left: 4px solid #718096;
}

/* Manual place search */
.search-card {
  border-left: 4px solid var(--accent);
  background: var(--blue-soft);
}

/* Suggestions */
.search-card + .card {
  border-left: 4px solid #d69e2e;
}

/* Existing-place editor */
.search-card + .card + .card {
  border-left: 4px solid var(--success);
}

.site-picker {
  padding: 16px;
  border: 1px solid var(--green-line);
  border-radius: 9px;
  background: var(--green-soft);
}

#siteEditor {
  margin-top: 24px;
  padding-top: 24px;
}

#editForm {
  padding: 18px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: var(--slate-soft);
}

#siteEditor > .subhead {
  margin-top: 24px;
  padding: 14px 16px;
  border: 1px solid var(--blue-line);
  border-radius: 9px;
  background: var(--blue-soft);
}

#siteEditor > .subhead:has(#findMorePhotos) {
  border-color: var(--green-line);
  background: var(--green-soft);
}

#editPhotos {
  padding: 14px;
  border: 1px solid var(--blue-line);
  border-radius: 9px;
  background: #f8fbff;
}

#editCandidates:empty {
  display: none;
}

#editCandidates:not(:empty) {
  padding: 14px;
  border: 1px solid var(--green-line);
  border-radius: 9px;
  background: #f8fdf9;
}

.photo {
  position: relative;
  transition:
    border-color 120ms ease,
    box-shadow 120ms ease,
    transform 120ms ease;
}

.photo:hover {
  border-color: #9ba9b5;
  box-shadow: 0 4px 12px rgba(29, 36, 41, 0.09);
  transform: translateY(-1px);
}

#editPhotos .photo {
  border-top: 3px solid #6ba2e8;
}

#editCandidates .photo {
  border-top: 3px solid #54a978;
}

.photo-body > label:first-of-type {
  display: block;
  margin-top: 10px;
  font-weight: 650;
}

.image-roles {
  padding: 9px;
  border: 0;
  border-radius: 6px;
  background: var(--slate-soft);
}

.image-roles label {
  display: flex;
  align-items: center;
  gap: 7px;
}

.move-buttons button {
  min-width: 38px;
  color: #33414b;
}

.remove-photo {
  padding-top: 8px;
  border-top: 1px solid #f1d0cd;
}

.addbar {
  border-color: #b8c2cb;
  box-shadow: 0 5px 20px rgba(29, 36, 41, 0.12);
}

#siteEditor .addbar {
  border-color: var(--green-line);
  background: rgba(247, 253, 249, 0.97);
}

.publish-card {
  border-left: 4px solid #7656c8;
  background: #f7f4ff;
}

#findMorePhotos {
  border-color: var(--success);
  color: var(--success);
}

#findMorePhotos:hover {
  border-color: #12633f;
  background: var(--success);
  color: #fff;
}

#saveSite {
  border-color: var(--success);
  background: var(--success);
}

#saveSite:hover {
  border-color: #12633f;
  background: #12633f;
}

#publish {
  border-color: #6844bd;
  background: #6844bd;
}

#publish:hover {
  border-color: #56359f;
  background: #56359f;
}

@media (max-width: 760px) {
  main {
    gap: 12px;
  }

  .card {
    padding: 16px;
  }

  .site-picker,
  #editForm,
  #editPhotos,
  #editCandidates:not(:empty) {
    padding: 12px;
  }

  #siteEditor > .subhead {
    padding: 12px;
  }

  #findMorePhotos {
    width: 100%;
  }
}
